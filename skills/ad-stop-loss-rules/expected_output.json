          "purchases_so_far": 0,
          "spend_multiple_of_target": 3.0,
          "stop_once_spend_passes": 120.0
        },
        {
          "purchases_so_far": 1,
          "spend_multiple_of_target": 4.74,
          "stop_once_spend_passes": 189.6
        },
        {
