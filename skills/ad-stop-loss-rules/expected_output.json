    "target_cost_per_purchase": 40.0,
    "currency": "USD",
    "window": "2026-07-29 to 2026-10-26 (90 days)",
    "data_through": "2026-10-26",
    "conversion_lag_days": 1,
    "platforms": [
      "tiktok-ads",
      "pinterest-ads"
    ]
  },
  "rules": [
    {
      "rule": "Spend against purchases",
      "stop_when": "the chance that the ad really costs $40 a purchase or less, given its spend and purchases so far, falls under 5%",
