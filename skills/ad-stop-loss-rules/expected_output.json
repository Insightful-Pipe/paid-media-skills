  "setup": [
    {
      "platform": "tiktok-ads",
      "how": "Saved as TikTok automated rules on new ads, one rule per rung of the ladder up to two purchases. The daily check covers the rest: the click-rate floor, the three-purchase rung, graduation and the overspend cap.",
      "action": "optimizer_rule_create",
      "status": "not run: drafted for confirmation",
      "check_before_run": "The helper lists only rule_name, conditions, actions, schedule, entity_type and entity_ids. Map each condition below to the field names actions_details returns for optimizer_rule_create, and use a time range that covers the whole test.",
      "payloads": [
        {
          "rule_name": "Stop-loss: no purchase by $120.00",
          "entity_type": "AD",
          "conditions": [
            {
              "metric": "spend",
              "operator": "greater than",
              "value": 120.0
            },
            {
              "metric": "conversion",
              "operator": "equals",
              "value": 0
            }
          ],
          "actions": [
            {
              "action": "turn off",
              "notify": true
            }
          ],
          "schedule": "every 30 minutes"
        },
        {
          "rule_name": "Stop-loss: 1 purchase by $189.60",
          "entity_type": "AD",
          "conditions": [
            {
              "metric": "spend",
              "operator": "greater than",
              "value": 189.6
            },
            {
              "metric": "conversion",
              "operator": "less than",
              "value": 2
            }
          ],
          "actions": [
            {
              "action": "turn off",
              "notify": true
            }
          ],
          "schedule": "every 30 minutes"
        },
        {
          "rule_name": "Stop-loss: 2 purchases by $252.00",
          "entity_type": "AD",
          "conditions": [
            {
              "metric": "spend",
              "operator": "greater than",
              "value": 252.0
            },
            {
              "metric": "conversion",
              "operator": "less than",
              "value": 3
            }
          ],
          "actions": [
            {
              "action": "turn off",
              "notify": true
            }
          ],
          "schedule": "every 30 minutes"
        }
      ]
    },
    {
      "platform": "tiktok-ads",
      "how": "Today's stop, as a one-off pause while the rules are not yet saved.",
      "action": "ad_status_update",
      "status": "not run: waiting for your yes",
      "payloads": [
        {
          "advertiser_id": "<ADVERTISER_ID>",
          "ad_ids": [
            "tt-a-508"
          ],
