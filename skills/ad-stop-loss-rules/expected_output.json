          "stop_once_spend_passes": 252.0
        },
        {
          "purchases_so_far": 3,
          "spend_multiple_of_target": 7.75,
          "stop_once_spend_passes": 310.0
        }
      ]
    },
    {
      "rule": "Click-rate floor",
      "stop_when": "no purchase yet, enough impressions for 30 clicks at the platform median, and click rate under half that median",
      "floors": [
        {
          "platform": "tiktok-ads",
          "ads_measured": 7,
          "median_ctr_percent": 1.11,
          "floor_ctr_percent": 0.56,
          "judge_after_impressions": 2800
        },
        {
          "platform": "pinterest-ads",
          "ads_measured": 4,
          "median_ctr_percent": 0.7,
          "floor_ctr_percent": 0.35,
          "judge_after_impressions": 4300
        }
      ]
    },
    {
      "rule": "Overspend",
      "stop_when": "a campaign spends more than 125% of its agreed daily cap in a day",
      "caps": [
        {
          "campaign": "Prospecting | Planters",
          "platform": "tiktok-ads",
          "daily_cap": 250
        },
        {
          "campaign": "UGC tests",
          "platform": "tiktok-ads",
          "daily_cap": 150
        },
        {
          "campaign": "Consideration | Planters",
          "platform": "pinterest-ads",
          "daily_cap": 120
        }
      ]
    },
    {
      "rule": "Grace and graduation",
      "stop_when": "no verdict before day 3 of delivery; an ad with 3 purchases at or under $40 leaves the stop-loss watch"
    }
  ],
