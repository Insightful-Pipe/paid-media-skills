    "thresholds": [
      "judge a row at 20+ clicks or spend >= target",
      "no return: spend >= target, 0 conversions",
      "accidental taps: 20+ clicks, CTR >= 3x the network's CTR",
      "thin visits: 30+ clicks, sessions per click or engaged share under half the baseline",
      "made for advertising, suspected: a site with 0 conversions and 2+ of taps, thin visits, viewability < 40%, invalid traffic >= 10%",
      "costly: CPR > 2x target on spend >= 2x target",
      "turn a network off: >= 20% of spend and CPR >= 2x the feed's (10+ feed results), or 0 results on spend >= 2x target"
    ]
